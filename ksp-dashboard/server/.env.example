# Personal API Token ClickUp (Settings > Apps > API Token, diawali "pk_")
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID List ClickUp yang mau disinkronkan.
# Default di bawah = list "List" di space AIO-KSP (workspace KSP).
CLICKUP_LIST_ID=901817330442

# Port server
PORT=3000

# Seberapa sering data ClickUp ditarik ulang (menit)
REFRESH_MINUTES=5
