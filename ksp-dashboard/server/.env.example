# ============ ClickUp ============
# Personal API Token ClickUp (Settings > Apps > API Token, diawali "pk_")
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID List yang disinkronkan (default = list "List" di space AIO-KSP)
CLICKUP_LIST_ID=901817330442
# Seberapa sering data ClickUp ditarik ulang (menit) — cadangan real-time
REFRESH_MINUTES=5
# (Opsional) Secret webhook ClickUp untuk update INSTAN saat task dibuat/diubah.
# Kosongkan bila hanya pakai auto-refresh. Isi string acak yang sama dengan
# yang didaftarkan di webhook ClickUp (lihat README).
CLICKUP_WEBHOOK_SECRET=

# ============ Server ============
PORT=3000

# ============ Better Auth (login) ============
# Kunci rahasia sesi — WAJIB diganti. Buat dengan:  openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32
# URL publik dashboard (harus sama dengan domain yang diakses browser)
BETTER_AUTH_URL=http://localhost:3000
# Origin yang diizinkan (pisahkan dengan koma bila lebih dari satu)
TRUSTED_ORIGINS=http://localhost:3000
# Lokasi file database SQLite untuk auth (opsional)
AUTH_DB_PATH=./auth.db

# ============ Akun Admin (dipakai sekali oleh: npm run seed) ============
ADMIN_EMAIL=kemal@alwildan.id
ADMIN_PASSWORD=GantiPasswordKuatMin8Karakter
ADMIN_NAME=Kemal Prabowo
