# Produksi — Traffic Pekerjaan KSP (Express + Better Auth)
# Salin ke .env (satu folder dengan docker-compose.yml), lalu: chmod 600 .env
# Semua nilai wajib diisi sebelum `docker compose up -d --build`.

# ============ ClickUp ============
# Personal API Token ClickUp (Settings > Apps > API Token, diawali "pk_").
# Catatan: token di ksp-dashboard/server/.env (lokal) saat ini invalid —
#          regenerasi di ClickUp sebelum go-live.
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID List yang disinkronkan (default: list "List" di space AIO-KSP)
CLICKUP_LIST_ID=901817330442

# Interval tarik ulang data ClickUp (menit) — cadangan real-time
REFRESH_MINUTES=5

# (Opsional) Secret webhook ClickUp untuk update INSTAN. Kosongkan bila
# hanya pakai auto-refresh. Harus sama dengan yang didaftarkan di webhook.
CLICKUP_WEBHOOK_SECRET=

# Port internal container (dipetakan ke 127.0.0.1:3100 oleh docker-compose)
PORT=3100

# Domain publik
APP_DOMAIN=ksp.office-alwildan.id

# Lokasi PROGRESS.md untuk panel Progress Launch (di-mount oleh docker-compose)
PROGRESS_FILE=/app/PROGRESS.md

# ============ Better Auth (login) ============
# Kunci rahasia sesi — WAJIB diganti. Buat dengan:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publik dashboard (harus sama dengan domain yang diakses browser)
BETTER_AUTH_URL=https://ksp.office-alwildan.id

# Origin yang diizinkan (pisahkan dengan koma bila lebih dari satu)
TRUSTED_ORIGINS=https://ksp.office-alwildan.id

# Lokasi file database SQLite untuk auth (disediakan volume oleh compose)
AUTH_DB_PATH=/app/data/auth.db

# ============ Akun Admin (dipakai saat start: migrate + seed) ============
# Email & kata sandi admin pertama. Kata sandi min. 8 karakter.
ADMIN_EMAIL=kemal@alwildan.id
ADMIN_PASSWORD=GantiPasswordKuatMin8Karakter
ADMIN_NAME=Kemal Prabowo