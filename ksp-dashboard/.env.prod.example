# Produksi — Dashboard Traffic Pekerjaan KSP
# Salin ke .env (satu folder dengan docker-compose.yml), lalu: chmod 600 .env
# Buat Personal API Token ClickUp: Settings > Apps > API Token (diawali "pk_")
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID List ClickUp yang disinkronkan (default: list "List" di space AIO-KSP)
CLICKUP_LIST_ID=901817330442

# Port internal container (dipetakan ke 127.0.0.1:3100 oleh docker-compose)
PORT=3100

# Interval tarik ulang data ClickUp (menit)
REFRESH_MINUTES=5

# Domain publik (catatan Caddy/README)
APP_DOMAIN=ksp.office-alwildan.id
